# better-sqlite3 13 ships prebuilt binaries inside the package, so no install script is needed.
# Without this line, npm tries to COMPILE it from source when installing from package-lock.json,
# which needs a C++ toolchain and internet access. If you later add a package that really needs
# a build step (e.g. a native password-hashing library), run: npm rebuild <package-name>
ignore-scripts=true
